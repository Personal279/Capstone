  <script>
    document.addEventListener("DOMContentLoaded",()=>{
      lucide.createIcons();
      const historyStack=["opening"];
      const reducedMotion=window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const homeContent=document.getElementById("home-content");
      window.setTimeout(()=>homeContent.classList.add("ready"),reducedMotion?100:1450);

      function showScreen(id,addToHistory=true){
        const current=document.querySelector(".screen.active");
        const target=document.getElementById(id);
        if(!target||target===current)return;
        if(current){current.classList.add("exit-left");current.classList.remove("active");window.setTimeout(()=>current.classList.remove("exit-left"),320)}
        target.classList.add("active");
        if(addToHistory)historyStack.push(id);
        target.scrollTop=0;
      }
      function goBack(){if(historyStack.length<=1)return;historyStack.pop();showScreen(historyStack[historyStack.length-1],false)}
      document.querySelectorAll("[data-next]").forEach(button=>button.addEventListener("click",()=>showScreen(button.dataset.next)));
      document.querySelectorAll("[data-back]").forEach(button=>button.addEventListener("click",goBack));
      document.querySelectorAll(".region-btn").forEach(button=>button.addEventListener("click",()=>{
        document.querySelectorAll(".region-btn").forEach(item=>item.classList.toggle("active",item===button));
        const selected=button.dataset.region;
        document.querySelectorAll("[data-measurement]").forEach(row=>{
          const active=row.dataset.measurement===selected;
          row.style.background=active?"#f0f1f8":"transparent";
          row.style.marginInline=active?"-16px":"0";
          row.style.paddingInline=active?"16px":"0";
        });
        ["eye","mouth","brow"].forEach(region=>document.getElementById("region-"+region).style.opacity=region===selected?"1":".25");
      }));
      document.querySelectorAll("[data-chart]").forEach(button=>button.addEventListener("click",()=>{
        document.querySelectorAll("[data-chart]").forEach(item=>item.className=item===button?"px-2 py-1 rounded text-[10px] bg-[#4b4f8e] text-white":"px-2 py-1 rounded text-[10px] text-[#526079]");
        const longRange=button.dataset.chart==="90";
        const d=longRange?"M0 105 C29 104 47 93 72 96 S108 86 128 88 S158 74 183 78 S221 61 248 59 S287 42 320 28":"M0 98 C35 94 53 91 78 94 S116 77 137 80 S170 70 190 73 S231 54 254 57 S290 36 320 28";
        document.getElementById("trend-path").setAttribute("d",d);
        document.getElementById("trend-fill").setAttribute("d","M0 112 L0 "+(longRange?"105":"98")+d.slice(d.indexOf(" C"))+" L320 112Z");
      }));
    });
